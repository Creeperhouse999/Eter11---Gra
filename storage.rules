rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    /**
     * Czy wgrywający należy do zespołu (konto e-mail/hasło).
     *
     * UWAGA — to nie jest zwykłe „zalogowany". Gra loguje graczy ANONIMOWO
     * (signInAnonymously w multiplayerze), więc `request.auth != null` jest
     * prawdą dla KAŻDEGO, kto zna publiczny config — a config jest publiczny
     * z założenia. Gdyby zapis do Storage sprawdzał tylko `auth != null`,
     * ktoś obcy zalogowałby się anonimowo i wgrał dowolną ilość plików na
     * cudzy rachunek (klasyczny „upload 36 TB na cudzy bucket").
     *
     * Konta zespołu zakłada właściciel w Firebase Console przez Email/Password,
     * więc mają `sign_in_provider == 'password'`. Anonimowa sesja gracza ma
     * `'anonymous'` i tu nie przechodzi.
     */
    function czlonekZespolu() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider == 'password';
    }

    /**
     * ZNANA LUKA (nienaprawiona — patrz uzasadnienie poniżej), do rozważenia
     * przez człowieka:
     *
     * `icons/`, `cards/`, `discussions/` wpuszczają do zapisu KAŻDE konto
     * zespołu (`czlonekZespolu()`), bez względu na rolę. Rola `viewer`
     * („tylko podgląd panelu: nic nie zmienia") ma w panelu schowane przyciski
     * edycji, a `firestore.rules` (`mozeEdytowac`/`mozeDyskutowac`) blokuje
     * odpowiadający zapis w Firestore — ale Storage to osobna usługa z
     * własnymi regułami, więc viewer wołający Storage SDK/REST wprost (z
     * pominięciem panelu) wciąż nadpisze widoczną graczom ikonę/grafikę karty
     * albo wgra się do `discussions/`.
     *
     * Właściwa naprawa to sprawdzenie roli tu tak samo jak w firestore.rules —
     * ALE reguły Storage czytają rolę z Firestore wyłącznie przez cross-service
     * `firestore.get()`/`firestore.exists()`, a Firebase Local Emulator Suite
     * (`npm run test:rules`) tego NIE obsługuje wiarygodnie: `firestore.exists()`
     * wołany z reguł Storage konsekwentnie zwraca `false` nawet dla realnie
     * zapisanego dokumentu (sprawdzone: zapis wprost przez REST Firestore
     * Emulatora, dopasowanie projectId do `.firebaserc` — bez zmiany wyniku).
     * Udokumentowany, wieloletni problem narzędzia, nie logiki reguł:
     * https://github.com/firebase/firebase-tools/issues/5251
     * https://github.com/firebase/firebase-js-sdk/issues/6803
     *
     * Naprawa bez działającego testu (który realnie odróżnia rolę viewer od
     * edytującej) nie została tu wdrożona — ryzyko cichego zablokowania
     * legalnych wgrań w produkcji przewyższa wagę luki (wymaga zalogowanego
     * konta zespołu, nie obcego z ulicy). Dwie sensowne drogi naprawy:
     * (a) wdrożyć cross-service regułę bez lokalnego testu, zweryfikować ręcznie
     *     na prawdziwym projekcie przed/po `firebase deploy --only storage`;
     * (b) trzymać rolę we custom claims tokena (Cloud Function na zapis
     *     `roles/{uid}`) — Storage czytałby `request.auth.token.role` bez
     *     cross-service wywołania, w pełni testowalne lokalnie.
     */

    /**
     * Obrazek, nie cokolwiek.
     *
     * Bez tego ktoś wgrałby pod adres z rozszerzeniem .jpg plik wykonywalny
     * i podał link jako „zrzut ekranu". Typ sprawdzamy po nagłówku, który
     * ustawia SDK, a rozmiar ucinamy zawczasu — kompresja po stronie klienta
     * schodzi poniżej 200 KB, więc 5 MB to sufit z dużym zapasem na wypadek
     * pominięcia kompresji (SVG, przezroczysty PNG).
     */
    function obrazek() {
      return request.resource.contentType.matches('image/.*')
             && request.resource.size < 5 * 1024 * 1024;
    }

    /**
     * Obrazek bitmapowy — bez SVG.
     *
     * SVG to XML, nie piksele: może nieść `<script>`/`onload`. `ImageLightbox`
     * ma link „otwórz surowy plik", który otwiera Storage jako dokument
     * najwyższego poziomu — tam taki skrypt wykonałby się w oczach zespołu.
     * `upload.ts` (SVG_FOLDERS) ogranicza to już po stronie klienta do
     * `icons`/`cards`, ale klient nie jest jedyną bramą do Storage — ktoś
     * może wołać SDK/REST wprost, z pominięciem aplikacji. `reports/` w ogóle
     * nie wymaga logowania (zgłoszenie z gry idzie bez konta), więc bez tej
     * reguły dowolna osoba wgrywa złośliwy SVG jako „zrzut ekranu błędu".
     * Regułą, nie tylko klientem, bo jedyną prawdziwą bramą do Storage są
     * reguły.
     */
    function bitmapa() {
      return request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp']
             && request.resource.size < 5 * 1024 * 1024;
    }

    /**
     * Ikony gry.
     *
     * Odczyt publiczny: ikony rysują się dzieciom, które kont nie mają.
     * Wgrywa i usuwa zespół — ikona trafia na karty, więc nie może jej
     * podmienić ktoś z ulicy.
     */
    match /icons/{file} {
      allow read: if true;
      allow write: if czlonekZespolu() && obrazek();
    }

    /**
     * Załączniki do zgłoszeń.
     *
     * Zgłoszenie może wysłać osoba testująca grę z dziećmi bez konta —
     * tak samo jak samo zgłoszenie w Firestore. Zrzut ekranu z błędem jest
     * częścią zgłoszenia, więc wgranie jest otwarte, ale ograniczone do
     * obrazka poniżej limitu. Odczyt publiczny: zespół czyta zgłoszenia
     * także narzędziami spoza aplikacji.
     */
    match /reports/{file} {
      // Odczyt tylko dla zespołu. Zrzut ekranu z błędem potrafi pokazać panel
      // redakcyjny, cudze dane albo stan konta — nie ma powodu, by mógł go
      // pobrać ktokolwiek z linkiem. Zgłoszenia ogląda się w panelu (tam
      // redaktor jest zalogowany kontem zespołu), więc podgląd działa jak
      // dotąd. Wcześniej było `read: if true`.
      allow read: if czlonekZespolu();
      // Zgłoszenie z gry wysyła gracz zalogowany anonimowo (nie ma konta), więc
      // create musi puścić anonima — inaczej zrzut ekranu z błędem nie dołączy.
      // Ochroną jest `bitmapa()` (typ bez SVG + twardy limit 5 MB): ktoś obcy
      // wgra co najwyżej rastrowy obrazek do 5 MB pod reports/, nie dowolną
      // treść, wielkie archiwa ani SVG ze skryptem. To świadomy kompromis,
      // żeby zgłaszanie z gry działało.
      allow create: if bitmapa();
      // Skasować może tylko zespół — sprzątanie po testach, nie cudza ręka.
      allow delete: if czlonekZespolu();
    }

    /**
     * Obrazki w dyskusjach.
     *
     * Dyskusje są dla zespołu i wymagają logowania — tak samo załączniki.
     */
    match /discussions/{file} {
      // Dyskusje są wewnętrzne — obrazek z wątku zespołu też. Odczyt tylko dla
      // zespołu (panel, gdzie i tak trzeba być zalogowanym). Było `if true`.
      allow read: if czlonekZespolu();
      // `bitmapa()`, nie `obrazek()` — SVG tu nie wolno, tak samo jak w
      // `reports/` (patrz komentarz przy `bitmapa()`). `upload.ts` już tego
      // pilnuje po stronie klienta, reguła pilnuje tego naprawdę.
      allow write: if czlonekZespolu() && bitmapa();
    }

    /**
     * Grafiki kart (problemy, kompetencje, talenty, mentorzy).
     *
     * Odczyt publiczny: karta z grafiką rysuje się dziecku, które konta nie ma.
     * Wgrywa i podmienia zespół — grafika trafia do gry, więc nie może jej
     * ustawić ktoś z ulicy. Jak ikony.
     */
    match /cards/{file} {
      allow read: if true;
      allow write: if czlonekZespolu() && obrazek();
    }

    // Wszystko inne zamknięte.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
