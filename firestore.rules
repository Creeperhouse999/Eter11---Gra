rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Czy piszący ma konto w tym projekcie.
     *
     * Konta zakłada wyłącznie właściciel projektu w Firebase Console —
     * rejestracji z aplikacji nie ma. Posiadanie konta JEST więc
     * uprawnieniem: zespół redakcyjny ma równe prawa, a osoba z ulicy
     * nie założy sobie konta sama.
     *
     * Wcześniej reguły uznawały jeden UID. Skutek: coworkerzy widzieli
     * „missing or insufficient permissions" przy każdej zmianie statusu
     * zgłoszenia, więc pętla „zgłoś → napraw → potwierdź" urywała się na
     * ostatnim kroku.
     */
    function zalogowany() {
      return request.auth != null;
    }

    /**
     * Czy to konto ZESPOŁU (e-mail/hasło), nie anonimowy gracz.
     *
     * KLUCZOWE: gra loguje graczy ANONIMOWO (signInAnonymously w multiplayerze),
     * więc `request.auth != null` jest prawdą dla KAŻDEGO obcego, kto zna
     * publiczny config. Konta zespołu zakłada właściciel przez Email/Password,
     * więc mają `sign_in_provider == 'password'`. Anonimowa sesja gracza ma
     * `'anonymous'`. Bez tego rozróżnienia anonim dostawał domyślną rolę
     * `coworker` i mógł nadpisać całą treść gry — patrz `mozeEdytowac`.
     */
    function czlonekZespolu() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider == 'password';
    }

    /**
     * Rola zalogowanego, czytana z kolekcji `roles/<uid>`.
     *
     * `info@eter11.pl` jest adminem zawsze — nawet gdy w bazie nic o nim nie
     * ma — żeby błąd w kolekcji ról nie odciął jedynej osoby, która może ją
     * naprawić. Konto zespołu bez wpisu = coworker (najniższy pracujący
     * poziom). Ktokolwiek NIE jest kontem zespołu (anonimowy gracz) = `viewer`,
     * czyli brak uprawnień edycyjnych — inaczej obcy z anonimową sesją
     * przechodziłby jako coworker i pisał do treści gry.
     */
    function rolaKonta() {
      return request.auth.token.email == 'info@eter11.pl'
        ? 'admin'
        : (!czlonekZespolu()
            ? 'viewer'
            : (exists(/databases/$(database)/documents/roles/$(request.auth.uid))
                ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role
                : 'coworker'));
    }

    function jestAdmin() {
      return zalogowany()
        && (rolaKonta() == 'admin' || rolaKonta() == 'programmer');
    }

    /** Admin i co-admin: moderują zgłoszenia, ale usuwa tylko admin. */
    function jestModeratorem() {
      return zalogowany()
        && (rolaKonta() == 'admin'
            || rolaKonta() == 'programmer'
            || rolaKonta() == 'co-admin');
    }

    /** Kto może pisać w dyskusjach: wszyscy poza edytorem i podglądem. */
    function mozeDyskutowac() {
      return zalogowany()
        && (rolaKonta() == 'admin'
            || rolaKonta() == 'programmer'
            || rolaKonta() == 'co-admin'
            || rolaKonta() == 'coworker');
    }

    /**
     * Kto może zmieniać treść gry: wszyscy poza `viewer`.
     *
     * `viewer` to sam podgląd. Wcześniej regułą zapisu treści było samo
     * `zalogowany()`, więc viewer mógł ominąć zablokowany w panelu przycisk
     * (przez konsolę/API) i nadpisać całą grę. Teraz zapis wymaga roli
     * edytującej — panel blokuje pola, a reguła domyka to od strony bazy.
     */
    function mozeEdytowac() {
      return zalogowany() && rolaKonta() != 'viewer';
    }

    // Zawartość gry: karty, problemy, postacie, parametry zasad.
    // Odczyt publiczny — gra ładuje dane bez logowania, także u dzieci,
    // które kont nie mają i mieć nie będą.
    match /content/{document} {
      allow read: if true;
      allow write: if mozeEdytowac();
    }

    // Zgłoszenia błędów i pomysłów od zespołu.
    //
    // Odczyt otwarty świadomie: pozwala odczytywać zgłoszenia narzędziami
    // spoza aplikacji, bez zakładania konta serwisowego. Treść to uwagi
    // o działaniu gry, więc nie wpisujemy tu danych osobowych ani haseł —
    // każdy, kto zna adres projektu, może je przeczytać.
    //
    // Tworzyć może każdy, także bez konta: zgłoszenie potrafi wysłać osoba
    // testująca grę z dziećmi, której nie zakładamy konta na jedno popołudnie.
    // Ograniczenia pól i długości chronią przed zalewaniem bazy.
    match /reports/{report} {
      allow read: if true;

      // Usuwa tylko admin — ani co-admin, ani coworker, nawet własnych.
      allow delete: if jestAdmin();

      // Zmiana STATUSU (akceptacja, odrzucenie, „naprawione", „działa",
      // „dalej nie działa", ponowne otwarcie) należy WYŁĄCZNIE do moderatora
      // (admin / co-admin / programmer). Tak zdecydował właściciel: o obiegu
      // zgłoszenia decyduje tylko zespół prowadzący, nie każdy zalogowany.
      //
      // Nie-moderatorowi (coworker/editor) wolno jedynie DOPISAĆ notatkę do
      // rozmowy pod zgłoszeniem — bez ruszania statusu ani żadnego innego pola,
      // i tylko dokładając (nie kasując cudzych). Viewer i anonim: nic.
      // Pola poza `status`/`notes` są w obu ścieżkach przypięte, więc nie da się
      // przy okazji podmienić autora, tytułu czy opisu.
      allow update: if jestModeratorem()
                    || (
                      mozeEdytowac()
                      // Tylko dopisanie notatki — status ZOSTAJE bez zmian.
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['notes'])
                      && request.resource.data.status == resource.data.status
                      // Notatek tylko przybywa — nie kasuje się cudzych.
                      && request.resource.data.get('notes', []).size()
                         >= resource.data.get('notes', []).size()
                    );

      // Tworzenie:
      // - moderator (admin/co-admin) może wpuścić od razu `new`,
      // - każdy inny (coworker, edytor, gracz z gry bez konta) tworzy tylko
      //   `pending` — trafia do akceptacji.
      allow create: if request.resource.data.keys().hasOnly(
                         ['kind', 'title', 'description', 'author', 'status', 'createdAt', 'images'])
                    && request.resource.data.kind in ['bug', 'idea']
                    && (request.resource.data.status == 'pending'
                        || (request.resource.data.status == 'new' && jestModeratorem()))
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 4000
                    && (!('images' in request.resource.data)
                        || (request.resource.data.images is list
                            && request.resource.data.images.size() <= 5));
    }

    /**
     * Role zespołu.
     *
     * Odczyt publiczny: panel i reguły muszą sprawdzić rolę, a nie ma tu nic
     * wrażliwego — sam adres e-mail i poziom dostępu. Nadaje wyłącznie admin;
     * co-admin i niżej nie zmieniają ról, także własnej (inaczej ktoś
     * podniósłby się do admina).
     */
    match /roles/{uid} {
      allow read: if true;

      // Nadanie/zmiana roli: walidujemy kształt zapisu.
      //
      // `color` jest opcjonalny — kolor awatara nadany w zakładce Zespół.
      // Gdy go nie ma, awatar liczy kolor z imienia jak dotąd. Gdy jest,
      // musi być hexem `#rrggbb`: to leci prosto do `style.background`, więc
      // dowolny string byłby wstrzyknięciem wartości CSS.
      // `name` — imię, którym podpisują się wpisy tej osoby. Trzymane tutaj,
      // bo `displayName` konta może zmienić wyłącznie jego właściciel, więc
      // podpisy tej samej osoby rozjeżdżały się i nie dało się ich uporządkować
      // z panelu. Nadaje je admin, jak rolę i kolor.
      allow create, update: if jestAdmin()
                   && request.resource.data.keys().hasOnly(['email', 'role', 'color', 'name'])
                   && (!('name' in request.resource.data)
                       || (request.resource.data.name is string
                           && request.resource.data.name.size() > 0
                           && request.resource.data.name.size() <= 40))
                   && request.resource.data.role in
                        ['admin', 'programmer', 'co-admin', 'coworker', 'editor', 'viewer']
                   && (!('color' in request.resource.data)
                       || (request.resource.data.color is string
                           && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')));

      // Usunięcie wpisu osobno: przy delete nie ma `request.resource.data`,
      // więc walidacja kształtu (jak wyżej) zawsze by je odrzuciła — dlatego
      // ta operacja ma własny warunek, samo `jestAdmin()`.
      allow delete: if jestAdmin();
    }

    /**
     * Dyskusje zespołu.
     *
     * Zgłoszenia są o tym, co nie działa — mają status i domykają się.
     * Dyskusja jest o tym, czego jeszcze nie ma: nowa mechanika, pomysł na
     * misję, spór o zasadę.
     *
     * Zakładać i pisać może tylko zalogowany, w przeciwieństwie do zgłoszeń:
     * pod wypowiedzią stoi imię z konta, więc musi być czym je potwierdzić.
     */
    match /discussions/{thread} {
      allow read: if true;
      // Zakładać wątek i pisać może każdy, kto ma prawo dyskutować; edytor
      // i podgląd nie. Usuwa tylko admin — reguła nie ufała rolom wcześniej,
      // więc podgląd z dostępem do SDK mógł skasować cudzy wątek.
      allow create: if mozeDyskutowac();
      allow delete: if jestAdmin();

      // Do wątku wolno WYŁĄCZNIE dopisywać, i tylko jedną wypowiedź naraz.
      //
      // Sam warunek „tablica nie krótsza" nie wystarczał: pozwalał podmienić
      // treść, autora albo datę już istniejącej wypowiedzi, byle długości nie
      // skrócić. Ktoś mógł przepisać cudzy wpis i dopisać własny w jednym
      // zapisie. Teraz sprawdzamy, że stare wypowiedzi zostają nietknięte —
      // nowa tablica bez ostatniego elementu musi być identyczna ze starą —
      // więc każda edycja historii jest odrzucana, a nie tylko skracanie.
      //
      // Pola tematu, autora i daty wątku zostają; `closed` wolno przełączać.
      allow update: if mozeDyskutowac()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['messages', 'closed'])
                    && request.resource.data.messages is list
                    && request.resource.data.messages.size() <= 200
                    && (
                      // Sama zmiana `closed`, bez ruszania wypowiedzi.
                      request.resource.data.messages == resource.data.messages
                      // Pierwsza wypowiedź w świeżym wątku: stara lista pusta,
                      // nowa ma dokładnie jeden element. Bez tej gałęzi warunek
                      // z porównaniem `[0:0]` do pustej listy padał, więc do
                      // KAŻDEGO nowego wątku nie dało się nic dopisać — „można
                      // było założyć wątek, ale nie wysłać wiadomości".
                      || (
                        resource.data.messages.size() == 0
                        && request.resource.data.messages.size() == 1
                      )
                      // Albo dokładnie jedna nowa wypowiedź na końcu, a cała
                      // wcześniejsza historia bez zmian.
                      || (
                        request.resource.data.messages.size()
                          == resource.data.messages.size() + 1
                        && request.resource.data.messages[0:resource.data.messages.size()]
                             == resource.data.messages
                      )
                    );
    }

    /**
     * Historia zapisów treści.
     *
     * Nadpisanie dokumentu z treścią kasuje poprzednią wersję bezpowrotnie —
     * to jedyna nieodwracalna operacja w panelu, a wykonują ją cztery osoby
     * na wspólnym dokumencie. Historia pozwala cofnąć cudzy albo własny
     * zapis zamiast odtwarzać go z pamięci.
     *
     * Odczyt TYLKO dla moderatorów (admin / co-admin). Historia to pełne
     * poprzednie wersje całej treści — wgląd w cudzą pracę i możliwość
     * cofnięcia. Zgłoszono, że nie powinni jej widzieć coworker/editor/viewer
     * ani ktokolwiek niezalogowany. Zapis nadal cały zespół (redaktorzy
     * dopisują wersje przy każdym zapisie treści).
     */
    match /contentHistory/{version} {
      allow read: if jestModeratorem();
      allow write: if mozeEdytowac();
    }

    /**
     * Pamięć zespołu — wspólny notatnik o projekcie i o nas samych.
     *
     * Jedno zdanie na wpis, bez tytułu i bez wątków. Czyta cały zespół razem
     * z Claude, więc kolejna rozmowa zaczyna się od tego, co już ustalone.
     *
     * Kto pisze: każdy poza `viewer` (ten sam próg co edycja treści). Swój wpis
     * autor poprawia i kasuje sam, cudze sprząta admin.
     *
     * Właściciela rozpoznajemy po `authorUid`, NIE po widocznym podpisie:
     * `author` to imię z konta, a konta bez ustawionego `displayName` w ogóle
     * nie mają go w tokenie (jest wtedy adres e-mail) — porównanie po imieniu
     * odcięłoby takim osobom poprawianie własnych wpisów. Uid jest zawsze
     * i nie da się go podszyć. Ani `authorUid`, ani `author` nie mogą się
     * zmienić przy poprawce, inaczej dałoby się przypisać sobie cudzy wpis.
     */
    match /memory/{note} {
      // Odczyt dla tych, którzy przy grze pracują — czyli tak jak zapis,
      // bez `viewer`. To notatki o nas i o pracy nad grą („kto za co
      // odpowiada", „ustaliliśmy X"), nie treść dla graczy ani dla konta
      // podglądowego. Gra tego nie czyta, więc zamknięcie niczego nie psuje.
      allow read: if mozeEdytowac();

      allow create: if mozeEdytowac()
                    && request.resource.data.keys()
                         .hasOnly(['text', 'author', 'authorUid', 'createdAt'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 300
                    && request.resource.data.author is string
                    && request.resource.data.author.size() > 0
                    // Wpis podpisuje się kontem piszącego — nie cudzym.
                    && request.resource.data.authorUid == request.auth.uid;

      // Poprawka: tylko treść i znacznik zmiany, tylko autor (albo admin).
      allow update: if mozeEdytowac()
                    && (jestAdmin() || resource.data.authorUid == request.auth.uid)
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['text', 'editedAt'])
                    && request.resource.data.authorUid == resource.data.authorUid
                    && request.resource.data.author == resource.data.author
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 300;

      allow delete: if jestAdmin()
                    || (mozeEdytowac() && resource.data.authorUid == request.auth.uid);
    }

    /**
     * Licznik rozegranych partii.
     *
     * Pisze go gra, a gra działa bez logowania — dzieci kont nie mają
     * i mieć nie będą. Zapis jest więc otwarty, ale wyłącznie dla czterech
     * liczników, tylko w górę i tylko o tyle, ile daje jedna partia.
     *
     * Uwaga: `increment` to delta wysyłana przez klienta, nie wartość liczona
     * po stronie serwera — sam z siebie niczego nie chroni. Jedyną ochroną
     * jest ta reguła, więc ogranicza nie tylko kierunek zmiany, ale i jej
     * rozmiar: bez limitu ktoś dopisałby milion jednym zapisem i skłamał
     * jedyną liczbę, którą zespół się kieruje.
     *
     * Nie ma tu nic o graczach: żadnych imion, postaci ani identyfikatorów.
     * Cztery liczby zbiorcze i nic więcej.
     */
    match /stats/play {
      allow read: if true;

      // Delta jednej partii dla danego pola — ile najwyżej wolno dodać za
      // jednym zapisem. `finished` i tutorial rosną o 1; `won` o 0 lub 1;
      // `missionsSolved` najwyżej o kilkanaście (misji w partii jest ~7,
      // zapas na wypadek luźniejszych zasad).
      function przyrost(pole, max) {
        let stare = resource == null ? 0 : resource.data.get(pole, 0);
        let nowe = request.resource.data[pole];
        return nowe >= stare && nowe <= stare + max;
      }

      allow write: if request.resource.data.keys().hasOnly(
                        ['finished', 'won', 'missionsSolved', 'tutorialsFinished'])
                   && request.resource.data.finished is int
                   && request.resource.data.won is int
                   && request.resource.data.missionsSolved is int
                   && request.resource.data.tutorialsFinished is int
                   && przyrost('finished', 1)
                   && przyrost('won', 1)
                   && przyrost('missionsSolved', 20)
                   && przyrost('tutorialsFinished', 1);
    }

    // Wszystkie pozostałe ścieżki zamknięte.
    // Bez tej reguły kolekcje dodane w przyszłości (pokoje gier w fazie 2)
    // mogłyby zostać otwarte przez przeoczenie.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
