rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Zawartość gry: karty, problemy, postacie, parametry zasad.
    // Odczyt publiczny — gra ładuje dane bez logowania.
    // Zapis wyłącznie z konta administracyjnego.
    //
    // UID konta info@eter11.pl (Firebase Console → Authentication → Users).
    // Zmiana konta wymaga podmiany tego UID i ponownego wdrożenia reguł.
    match /content/{document} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == 'N8KRfRuZmpf3ccHhKXXuPaPBKId2';
    }

    // Zgłoszenia błędów i pomysłów od zespołu.
    //
    // Odczyt otwarty świadomie: pozwala odczytywać zgłoszenia narzędziami
    // spoza aplikacji, bez zakładania konta serwisowego. Treść to uwagi
    // o działaniu gry, więc nie wpisujemy tu danych osobowych ani haseł —
    // każdy, kto zna adres projektu, może je przeczytać.
    //
    // Tworzyć może każdy: zespół merytoryczny nie ma kont, a wymaganie
    // logowania zniechęciłoby do zgłaszania. Ograniczenia pól i długości
    // chronią przed zalewaniem bazy.
    //
    // Zmiana statusu i usuwanie pozostają przy koncie administracyjnym,
    // żeby nikt z zewnątrz nie zamknął cudzego zgłoszenia.
    match /reports/{report} {
      allow read: if true;
      allow delete: if request.auth != null
                    && request.auth.uid == 'N8KRfRuZmpf3ccHhKXXuPaPBKId2';

      // Zmiana statusu bez logowania.
      //
      // Zespół merytoryczny zgłasza błędy i sam sprawdza, czy naprawa
      // działa — bez tego pętla „zgłoś → napraw → potwierdź" urywa się na
      // ostatnim kroku, a osoba zgłaszająca dostaje „missing or insufficient
      // permissions" dokładnie wtedy, gdy chce potwierdzić poprawkę.
      //
      // Ruszyć wolno wyłącznie `status` i `notes`; tytuł, opis, rodzaj,
      // autor i data pozostają takie, jak w chwili zgłoszenia — inaczej
      // ktoś z zewnątrz mógłby podmienić treść cudzego zgłoszenia.
      allow update: if request.auth != null
                       && request.auth.uid == 'N8KRfRuZmpf3ccHhKXXuPaPBKId2'
                    || (
                      request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['status', 'notes'])
                      && request.resource.data.status in
                           ['new', 'fixed', 'rejected', 'done']
                      // Notatki tylko dopisujemy — kasowanie cudzych
                      // komentarzy nie jest częścią potwierdzania naprawy.
                      //
                      // `get` z wartością domyślną, bo zgłoszenia wysyłane
                      // przez aplikację nie mają pola `notes` wcale: reguła
                      // tworzenia dopuszcza dokładnie sześć pól i `notes`
                      // nie jest jednym z nich.
                      && request.resource.data.get('notes', []).size()
                         >= resource.data.get('notes', []).size()
                      && request.resource.data.get('notes', []).size() <= 50
                    );

      allow create: if request.resource.data.keys().hasOnly(
                         ['kind', 'title', 'description', 'author', 'status', 'createdAt'])
                    && request.resource.data.kind in ['bug', 'idea']
                    && request.resource.data.status == 'new'
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 4000;
    }

    // Wszystkie pozostałe ścieżki zamknięte.
    // Bez tej reguły kolekcje dodane w przyszłości (pokoje gier w fazie 2)
    // mogłyby zostać otwarte przez przeoczenie.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
