{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('players').child(auth.uid).exists() || data.child('hostUid').val() === auth.uid)",
        "players": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('rooms').child($code).child('hostUid').val() === auth.uid)",
            "uid": { ".validate": "newData.val() === $uid" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "online": { ".validate": "newData.isBoolean()" },
            "ready": { ".validate": "newData.isBoolean()" }
          }
        },
        "kicked": {
          ".write": "auth != null && root.child('rooms').child($code).child('hostUid').val() === auth.uid"
        },
        "reactions": {
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
        },
        "offer": {
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
        }
      }
    }
  }
}
