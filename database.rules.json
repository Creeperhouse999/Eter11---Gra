{
  "rules": {
    "$other": { ".read": false, ".write": false },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('hostUid').val() === auth.uid",
        ".validate": "$code.length >= 4 && $code.length <= 8",
        "state": {
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
        },
        "lastAction": {
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
          ".validate": "!newData.exists() || newData.val().length <= 4000"
        },
        "turnStartedAt": {
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
          ".validate": "newData.isNumber()"
        },
        "phase": {
          ".write": "auth != null && (!data.parent().exists() || root.child('rooms').child($code).child('hostUid').val() === auth.uid)",
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "hostUid": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('rooms').child($code).child('hostUid').val() === auth.uid)",
            "uid": { ".validate": "newData.val() === $uid" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "online": { ".validate": "newData.isBoolean()" },
            "ready": { ".validate": "newData.isBoolean()" },
            "characterId": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$otherPlayerField": { ".validate": false }
          }
        },
        "kicked": {
          ".write": "auth != null && root.child('rooms').child($code).child('hostUid').val() === auth.uid"
        },
        "reactions": {
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
          "$reaction": {
            "kind": { ".validate": "newData.isString() && newData.val().length <= 32" }
          }
        },
        "offer": {
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
        }
      }
    }
  }
}
